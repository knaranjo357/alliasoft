# Base pública de tu instancia de n8n, sin / al final.
N8N_BASE_URL=https://TU-N8N.example.com

# Opcional: usa URLs completas si cada webhook vive en otra instancia.
# N8N_LEADS_WEBHOOK_URL=https://TU-N8N.example.com/webhook/alliasoft/webpage
# N8N_AVAILABILITY_WEBHOOK_URL=https://TU-N8N.example.com/webhook/alliasoft/webpage/availability
# N8N_BOOKING_WEBHOOK_URL=https://TU-N8N.example.com/webhook/alliasoft/webpage/booking

# Secreto compartido con la credencial Header Auth de n8n.
N8N_WEBHOOK_TOKEN=genera-un-valor-largo-y-aleatorio
